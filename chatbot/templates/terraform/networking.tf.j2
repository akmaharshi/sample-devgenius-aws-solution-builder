{% set vpc_services = architecture.get_services_by_category('networking') %}
{% set has_vpc = false %}
{% for service in vpc_services %}
{% if service.service_type == 'vpc' %}
{% set has_vpc = true %}
# VPC Configuration
module "vpc" {
  source  = "terraform-aws-modules/vpc/aws"
  version = "~> 5.0"

  name = "${local.architecture_name}-vpc"
  cidr = var.vpc_cidr

  azs = slice(local.availability_zones, 0, var.availability_zones_count)

  # Subnet configuration
  private_subnets = [
    for idx in range(var.availability_zones_count) :
    cidrsubnet(var.vpc_cidr, 4, idx)
  ]

  public_subnets = [
    for idx in range(var.availability_zones_count) :
    cidrsubnet(var.vpc_cidr, 4, idx + var.availability_zones_count)
  ]

  # Database subnets (optional)
{% if architecture.get_services_by_category('database') | length > 0 %}
  database_subnets = [
    for idx in range(var.availability_zones_count) :
    cidrsubnet(var.vpc_cidr, 4, idx + (var.availability_zones_count * 2))
  ]
  create_database_subnet_group = true
{% endif %}

  # NAT Gateway configuration
  enable_nat_gateway     = var.enable_nat_gateway
  single_nat_gateway     = {{ 'true' if architecture.environment.value == 'dev' else 'false' }}
  one_nat_gateway_per_az = {{ 'true' if architecture.environment.value == 'prod' else 'false' }}

  # VPN Gateway
  enable_vpn_gateway = var.enable_vpn_gateway

  # DNS
  enable_dns_hostnames = true
  enable_dns_support   = true

  # Flow logs (for production)
{% if architecture.environment.value == 'prod' %}
  enable_flow_log                      = true
  create_flow_log_cloudwatch_iam_role  = true
  create_flow_log_cloudwatch_log_group = true
  flow_log_retention_in_days           = 7
{% endif %}

  tags = merge(
    local.common_tags,
    {
      Name = "${local.architecture_name}-vpc"
      Service = "VPC"
    }
  )

  public_subnet_tags = {
    Type = "Public"
  }

  private_subnet_tags = {
    Type = "Private"
  }

{% if architecture.get_services_by_category('database') | length > 0 %}
  database_subnet_tags = {
    Type = "Database"
  }
{% endif %}
}

# VPC Endpoints (for private connectivity to AWS services)
{% if architecture.security.enable_encryption_in_transit %}
module "vpc_endpoints" {
  source  = "terraform-aws-modules/vpc/aws//modules/vpc-endpoints"
  version = "~> 5.0"

  vpc_id = module.vpc.vpc_id

  endpoints = {
    s3 = {
      service         = "s3"
      service_type    = "Gateway"
      route_table_ids = flatten([module.vpc.private_route_table_ids])
      tags = {
        Name = "${local.architecture_name}-s3-endpoint"
      }
    }

    dynamodb = {
      service         = "dynamodb"
      service_type    = "Gateway"
      route_table_ids = flatten([module.vpc.private_route_table_ids])
      tags = {
        Name = "${local.architecture_name}-dynamodb-endpoint"
      }
    }
  }

  tags = local.common_tags
}
{% endif %}
{% endif %}
{% endfor %}

{% if not has_vpc %}
# Default VPC - Creating VPC as it's required but not detected in diagram
module "vpc" {
  source  = "terraform-aws-modules/vpc/aws"
  version = "~> 5.0"

  name = "${local.architecture_name}-vpc"
  cidr = var.vpc_cidr

  azs             = slice(local.availability_zones, 0, var.availability_zones_count)
  private_subnets = [for idx in range(var.availability_zones_count) : cidrsubnet(var.vpc_cidr, 4, idx)]
  public_subnets  = [for idx in range(var.availability_zones_count) : cidrsubnet(var.vpc_cidr, 4, idx + var.availability_zones_count)]

  enable_nat_gateway = var.enable_nat_gateway
  single_nat_gateway = {{ 'true' if architecture.environment.value == 'dev' else 'false' }}

  enable_dns_hostnames = true
  enable_dns_support   = true

  tags = local.common_tags
}
{% endif %}

# Security Groups
locals {
  # Common security group rules
  ingress_rules = {
    http = {
      from_port   = 80
      to_port     = 80
      protocol    = "tcp"
      cidr_blocks = ["0.0.0.0/0"]
      description = "HTTP"
    }
    https = {
      from_port   = 443
      to_port     = 443
      protocol    = "tcp"
      cidr_blocks = ["0.0.0.0/0"]
      description = "HTTPS"
    }
  }
}
