# Terraform Configuration for {{ architecture.architecture_name }}
# Generated by DevGenius AI-IaC Platform
# Environment: {{ architecture.environment.value }}
# Region: {{ architecture.aws_region }}
# Version: {{ architecture.version }}

terraform {
  required_version = ">= 1.0"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
}

provider "aws" {
  region = var.aws_region

  default_tags {
    tags = {
{% for key, value in architecture.tags.items() %}
      "{{ key }}" = "{{ value }}"
{% endfor %}
      "Environment"    = "{{ architecture.environment.value }}"
      "ManagedBy"      = "Terraform"
      "GeneratedBy"    = "DevGenius"
      "Architecture"   = "{{ architecture.architecture_name }}"
    }
  }
}

# Local variables
locals {
  environment         = "{{ architecture.environment.value }}"
  architecture_name   = "{{ architecture.architecture_name }}"
  aws_region          = var.aws_region
  availability_zones  = data.aws_availability_zones.available.names

  # Common tags
  common_tags = {
    Environment    = local.environment
    Architecture   = local.architecture_name
    ManagedBy      = "Terraform"
    GeneratedBy    = "DevGenius"
  }
}

# Data sources
data "aws_availability_zones" "available" {
  state = "available"
}

data "aws_caller_identity" "current" {}

data "aws_region" "current" {}
