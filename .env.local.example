# DevGenius Local Mode Configuration
# Copy this file to .env.local and update the values

# Enable local mode (set to "true" for local development)
LOCAL_MODE=true

# Local data storage path
LOCAL_DATA_PATH=./local_data

# AWS Region (still needed for Bedrock API if using AWS credentials)
AWS_REGION=us-west-2

# AWS Credentials (optional - only if you want to use Bedrock)
# If not provided, the app will try to use default AWS credential chain
# AWS_ACCESS_KEY_ID=your_access_key_here
# AWS_SECRET_ACCESS_KEY=your_secret_key_here
# AWS_PROFILE=your_profile_name

# Bedrock Configuration (optional - only needed if using AWS Bedrock)
# If you have AWS credentials configured, you can use Bedrock agents
# Otherwise, the app will work with limited functionality
# BEDROCK_AGENT_ID=your_agent_id
# BEDROCK_AGENT_ALIAS_ID=your_agent_alias_id

# Bedrock Model ID (optional - defaults to Claude 3.5 Sonnet)
# BEDROCK_MODEL_ID=us.anthropic.claude-3-5-sonnet-20241022-v2:0

# Authentication (optional - disable for local development)
ENABLE_AUTH=false

# Application Port (optional)
PORT=8501
